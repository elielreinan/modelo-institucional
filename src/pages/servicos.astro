---
import Icon from "../components/Icon.astro";
import PageHeading from "../components/PageHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { services } from "../data";
import SiteLayout from "../layouts/SiteLayout.astro";
import { sitePath } from "../utils/sitePath";
---

<SiteLayout
  title="Serviços municipais"
  description="Consulte os serviços digitais e os canais de atendimento da Prefeitura."
>
  <main id="conteudo">
    <PageHeading
      eyebrow="Atendimento ao cidadão"
      title="Serviços municipais"
      description="Consulte os serviços e encontre o canal de atendimento adequado."
    />
    <section class="inner-section container">
      <div class="service-grid service-grid--page">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
      <div class="info-banner">
        <span class="info-banner__icon"><Icon name="people" size={26} /></span>
        <div>
          <h2>Não encontrou o que procura?</h2>
          <p>Entre em contato com a equipe de atendimento da Prefeitura.</p>
        </div>
        <a class="button button--green" href={sitePath("/contato")}>Fale conosco <Icon name="arrow" size={17} /></a>
      </div>
    </section>
  </main>
</SiteLayout>
